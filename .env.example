# Copy to .env and fill in. Never commit .env or paste these values into a chat.

# --- OpenAI (Stage 3) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Google Drive (Stage 2) ---
# ID from the Drive folder URL: drive.google.com/drive/folders/<this part>
DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
POLL_INTERVAL_SECONDS=60

# --- Jira (Stage 6) ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# --- Slack (Stage 6) ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- Gmail (Stage 6) ---
GMAIL_CLIENT_SECRET_FILE=credentials_gmail.json
GMAIL_TOKEN_FILE=token_gmail.json
GMAIL_SENDER=
SUMMARY_EMAIL_RECIPIENTS=

# --- App ---
DATABASE_PATH=data/meeting_agent.db
# true = fake Jira, Slack and email clients. Nothing leaves your machine.
USE_MOCK_INTEGRATIONS=true
